{
  "name": "quran-school-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-school / multi-branch Quran School Management System (modular monolith)",
  "main": "dist/app/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "api:verify": "vitest run tests/api-docs",
    "api:export": "tsx scripts/export-openapi.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "bootstrap:main-admin": "tsx src/app/cli/bootstrap-main-admin.ts",
    "bootstrap:organization": "tsx src/app/cli/bootstrap-organization.ts",
    "seed:geography": "tsx src/app/cli/seed-geography.ts",
    "convert:quran": "tsx src/app/cli/convert-kfgqpc-hafs.ts",
    "verify:quran": "tsx docs/verification/module21/verify-module21-real-dataset.ts",
    "import:quran": "tsx src/app/cli/import-quran-structure.ts",
    "person-names:report": "tsx src/app/cli/person-names.ts report",
    "person-names:apply": "tsx src/app/cli/person-names.ts apply"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "sequelize": "^6.37.5",
    "swagger-ui-dist": "5.33.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "4.1.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "nodemon": "^3.1.7",
    "openapi-types": "12.1.3",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
