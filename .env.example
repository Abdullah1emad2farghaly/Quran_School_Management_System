# Copy to .env and fill in. NEVER commit .env or real secrets (.env is git-ignored).
# Secrets below are placeholders: generate your own, for example `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# In production every secret must be at least 32 characters (the app refuses to start otherwise).

NODE_ENV=development            # development | test | production
PORT=3000
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Africa/Cairo       # business/display timezone (DB stays UTC)
DEFAULT_LOCALE=ar               # ar | en
LOG_LEVEL=info                  # silent | error | warn | info | debug (default: silent in test)

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=quran_schools_management
DATABASE_USER=root
DATABASE_PASSWORD=change-me

JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-secret
OTP_HMAC_SECRET=change-me-generate-a-third-long-random-secret   # password-recovery OTP hashing (Module 11)
OTP_SENDER=disabled             # disabled | dev-file (dev-file is development only; a real provider is not chosen yet)
TRUSTED_PROXIES=                # comma-separated IPs/CIDRs/loopback of reverse proxies; empty = trust none

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILE_STORAGE_PATH=./storage
MAX_FILE_SIZE=10485760          # bytes
